# ==================================================
# FoodBridge Backend Environment Configuration
# ==================================================

# Environment & Application Settings
FLASK_APP=app.py
FLASK_ENV=development
APP_ENV=development
API_VERSION=v1
DEBUG=True
PORT=5000

# Security & Secrets
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Database Settings (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=foodbridge_db
MYSQL_USERNAME=foodbridge_user
MYSQL_PASSWORD=foodbridge_password
DATABASE_URL=mysql+pymysql://foodbridge_user:foodbridge_password@localhost:3306/foodbridge_db

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Settings
LOG_LEVEL=DEBUG
LOG_FILE_PATH=logs/app.log
